doc_to_text: "{{question}} Let's think step by step."
doc_to_target: "{{answer}}"
generation_kwargs:
  max_gen_toks: 1024
  do_sample: false
  temperature: 0
  until: []
repeats: 1
num_fewshot: 0
filter_list:
  - name: extract_answers
    filter:
      - function: "custom"
        filter_fn: !function utils.math_parse
metric_list:
  - metric: !function utils.exact_match
    aggregation: mean
    higher_is_better: true
metadata:
  version: 1.0
